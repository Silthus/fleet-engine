  "jobs": [
    {
      "id": "fleet-update",
      "command": [
        "fleet",
        "nightly",
        "fleet-update",
        "--",
        "fleet",
        "update"
      ],
      "schedule": {
        "every": "1h",
        "at": "00:17"
      },
      "workflow": "nightly-updates"
    },
    {
      "id": "agent-update",
      "command": [
        "fleet",
        "nightly",
        "agent-update",
        "--",
        "fleet",
        "agent-update"
      ],
      "schedule": {
        "every": "1h",
        "at": "00:47"
      },
      "workflow": "nightly-updates"
    },
    {
      "id": "worktree-prune",
      "command": [
        "fleet",
        "prune",
        "--auto"
      ],
      "schedule": {
        "every": "5m"
      },
      "workflow": "worktree-cleanup"
    }
  ],
  "steps": [
    {
      "id": "settings-snapshot",
      "run": [
        "fleet",
        "settings-snapshot"
      ],
      "check": [
        "fleet",
        "settings-snapshot",
        "--check"
      ]
    },
    {
      "id": "shell-session",
      "run": [
        "fleet",
        "shell-session"
      ],
      "check": [
        "fleet",
        "shell-session",
        "--check"
      ],
      "on": [
        "linux"
      ]
    },
    {
      "id": "claude-cli",
      "run": [
        "bash",
        "-c",
        "set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash"
      ],
      "check": [
        "claude",
        "--version"
      ],
      "plans": [
        "claude",
        "both"
      ]
    },
    {
      "id": "codex-cli",
      "run": [
        "fleet",
        "install-codex"
      ],
      "check": [
        "codex",
        "--version"
      ],
      "on": [
        "linux",
        "darwin"
      ],
      "plans": [
        "codex",
        "both"
      ]
    },
    {
      "id": "cargo-git-cli",
      "run": [
        "fleet",
        "cargo-git-cli"
      ],
      "check": [
        "fleet",
        "cargo-git-cli",
        "--check"
      ],
      "on": [
        "linux"
      ]
    },
    {
      "id": "node-runtime",
      "run": [
        "fleet",
        "install-node"
      ],
      "check": [
        "npx",
        "--version"
      ],
      "on": [
        "linux"
      ]
    }
  ]
}
