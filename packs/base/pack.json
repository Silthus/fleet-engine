{
  "schema": 1,
  "name": "base",
  "summary": "Every machine gets safety rules, the model table, T3 Code defaults, and the jobs that keep it current.",
  "day": "Agents ask before they break things, pick the right model for each task, and every machine is up to date when you start.",
  "cost": "You set up nothing. Every Fleet machine gets it.",
  "risk": "Fleet owns its hooks in Claude Code and Codex. Fleet keeps a hook that you wrote yourself on the same event until you adopt Fleet's.",
  "instructions": "AGENTS.md",
  "guides": [
    {
      "guide": "coding-standards",
      "path": "coding-standards.md"
    },
    {
      "guide": "t3",
      "path": "t3.md"
    }
  ],
  "models": {
    "claude": [
      {
        "role": "lookup",
        "work": "Lookups: find files, take an inventory, extract from logs",
        "provider": "claude",
        "model": "claude-haiku-5-5",
        "effort": "medium"
      },
      {
        "role": "survey",
        "work": "Surveys: read docs, the web, or one area of the code and summarize",
        "provider": "claude",
        "model": "claude-sonnet-5-5",
        "effort": "high"
      },
      {
        "role": "research",
        "work": "Deep research on how code behaves, where a wrong answer misleads a decision",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "effort": "high"
      },
      {
        "role": "implementation",
        "work": "Implementation, tests, fixes, and UI work",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "effort": "high"
      },
      {
        "role": "review",
        "work": "Review, in a fresh session that did not write the code",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "effort": "high"
      }
    ],
    "codex": [
      {
        "role": "lookup",
        "work": "Lookups: find files, take an inventory, extract from logs",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "low"
      },
      {
        "role": "survey",
        "work": "Surveys: read docs, the web, or one area of the code and summarize",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      {
        "role": "research",
        "work": "Deep research on how code behaves, where a wrong answer misleads a decision",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "role": "implementation",
        "work": "Implementation, tests, fixes, and UI work",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "role": "review",
        "work": "Review, in a fresh session that did not write the code",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      }
    ],
    "both": [
      {
        "role": "lookup",
        "work": "Lookups: find files, take an inventory, extract from logs",
        "provider": "claude",
        "model": "claude-haiku-5-5",
        "effort": "medium"
      },
      {
        "role": "survey",
        "work": "Surveys: read docs, the web, or one area of the code and summarize",
        "provider": "claude",
        "model": "claude-sonnet-5-5",
        "effort": "high"
      },
      {
        "role": "research",
        "work": "Deep research on how code behaves, where a wrong answer misleads a decision",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "role": "implementation",
        "work": "Implementation, tests, fixes, and UI work",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "effort": "high"
      },
      {
        "role": "review",
        "work": "Review of code Claude wrote",
        "provider": "codex",
        "model": "gpt-6.1-sol",
        "effort": "high"
      },
      {
        "role": "review-codex",
        "work": "Review of code Codex wrote, and of skills and agent documents",
        "provider": "claude",
        "model": "claude-opus-5-5",
        "effort": "high"
      }
    ]
  },
  "settings": [
    {
      "key": "base.heavySlots",
      "question": "How many heavy commands may run at once?",
      "type": "number",
      "default": 2,
      "ask": "never"
    },
    {
      "key": "base.diskFloorGigabytes",
      "question": "Below how many free gigabytes should Fleet refuse new worktrees and heavy jobs?",
      "type": "number",
      "default": 10,
      "ask": "never"
    },
    {
      "key": "base.startFloorGigabytes",
      "question": "Below how many free gigabytes should fleet disk --start refuse a new thread or scheduled run?",
      "type": "number",
      "default": 25,
      "ask": "never"
    },
    {
      "key": "identity.signer",
      "question": "Which key signs your Git commits? Fleet picks coder in a Coder workspace and ssh everywhere else.",
      "type": "choice",
      "choices": [
        {
          "value": "ssh",
          "label": "A Fleet SSH key"
        },
        {
          "value": "coder",
          "label": "Your Coder workspace's Git SSH key"
        },
        {
          "value": "1password",
          "label": "Your 1Password SSH key"
        }
      ],
      "default": "ssh",
      "ask": "never"
    }
  ],
  "workflows": [
    {
      "id": "agent-rules",
      "name": "Agent rules",
      "default": true,
      "sentence": "Agents confirm destructive actions, keep private data out of public repos, and pick the right model for each task."
    },
    {
      "id": "t3-tuned",
      "name": "T3 Code tuned",
      "default": true,
      "sentence": "Each thread gets its own worktree, and threads that hit a usage limit resume by themselves. A worktree without uncommitted changes is removed when its thread settles or after five days."
    },
    {
      "id": "nightly-updates",
      "name": "Nightly updates",
      "default": true,
      "sentence": "Fleet, your profile, Claude Code, Codex, their plugins, and T3 Code update themselves every night. T3 Code waits until no agent turn runs. A failed update tries again each hour until 05:47 UTC."
    },
    {
      "id": "linked-machines",
      "name": "Linked machines",
      "default": true,
      "needs": [
        "devbox"
      ],
      "sentence": "Your Mac and your devboxes see each other's threads."
    },
    {
      "id": "worktree-cleanup",
      "name": "Worktree cleanup",
      "default": true,
      "sentence": "Every few minutes, Fleet removes idle worktrees whose work has merged."
    },
    {
      "id": "disk-guard",
      "name": "Disk guard",
      "default": true,
      "needs": [
        "devbox"
      ],
      "sentence": "Agents check free disk before big jobs and run builds and tests in a capped slot, so one job cannot fill or freeze a devbox."
    },
    {
      "id": "format-on-edit",
      "name": "Format on edit",
      "default": false,
      "sentence": "After Claude edits a file, the repository's own lint-staged formatters and fixers rewrite it, and Claude sees what they could not fix.",
      "risk": "It runs after every edit in every repository, before you review the change, not only at commit. It runs only known formatters (Prettier, Biome, ESLint, Ruff, Black, gofmt, rustfmt and a few more) that the repository's lint-staged config names, from the repository's node_modules/.bin or your PATH. It never runs package runners such as bunx or npx, interpreters, shells, scripts, or Git. A formatter still loads the repository's own config, and some configs, such as eslint.config.js, are code."
    }
  ],
  "config": [
