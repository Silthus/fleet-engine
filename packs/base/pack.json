  "files": [
    {
      "path": "hooks/run.sh",
      "target": ".config/fleet/hooks/run.sh"
    },
    {
      "path": "hooks/run.ts",
      "target": ".config/fleet/hooks/run.ts"
    },
    {
      "path": "hooks/secret-guard.ts",
      "target": ".config/fleet/hooks/UserPromptSubmit/secret-guard.ts"
    },
    {
      "path": "hooks/secret-guard.ts",
      "target": ".config/fleet/hooks/PostToolUse/secret-guard.ts"
    },
    {
      "path": "hooks/name-a-model.ts",
      "target": ".config/fleet/hooks/PreToolUse/name-a-model.ts",
      "plans": [
        "claude",
        "both"
      ]
    },
    {
      "path": "hooks/format-on-edit.ts",
      "target": ".config/fleet/hooks/PostToolUse/format-on-edit.ts",
      "plans": [
        "claude",
        "both"
      ],
      "workflow": "format-on-edit"
    },
    {
      "path": "fleet-heavy.slice",
      "target": ".config/systemd/user/fleet-heavy.slice",
      "on": [
        "linux"
      ],
      "workflow": "disk-guard"
    },
    {
      "path": "session.sh",
      "target": ".config/fleet/session.sh",
      "on": [
        "linux"
      ]
    }
