      "provider": "claude",
      "key": "hooks.UserPromptSubmit",
      "value": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh \"$HOME/.config/fleet/hooks/run.sh\" claude UserPromptSubmit",
              "timeout": 30
            }
          ]
        }
      ]
    },
    {
      "provider": "claude",
      "key": "hooks.PreToolUse",
      "value": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "sh \"$HOME/.config/fleet/hooks/run.sh\" claude PreToolUse",
              "timeout": 30
