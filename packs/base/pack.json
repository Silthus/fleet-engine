  "files": [
    {
      "path": "hooks/run.sh",
      "target": ".config/fleet/hooks/run.sh"
    },
    {
      "path": "hooks/run.ts",
      "target": ".config/fleet/hooks/run.ts"
    },
    {
      "path": "hooks/secret-guard.ts",
      "target": ".config/fleet/hooks/UserPromptSubmit/secret-guard.ts"
    },
    {
      "path": "hooks/secret-guard.ts",
      "target": ".config/fleet/hooks/PostToolUse/secret-guard.ts"
    },
    {
      "path": "hooks/name-a-model.ts",
      "target": ".config/fleet/hooks/PreToolUse/name-a-model.ts",
      "plans": [
        "claude",
        "both"
      ]
    },
    {
      "path": "fleet-heavy.slice",
      "target": ".config/systemd/user/fleet-heavy.slice",
      "on": [
        "linux"
      ],
      "workflow": "disk-guard"
    },
    {
      "path": "session.sh",
      "target": ".config/fleet/session.sh",
      "on": [
        "linux"
      ]
    }
  ],
  "jobs": [
    {
      "id": "fleet-update",
      "command": [
        "fleet",
        "nightly",
        "fleet-update",
        "--",
        "fleet",
        "update"
      ],
      "schedule": {
        "every": "1h",
        "at": "00:17"
      },
      "workflow": "nightly-updates"
    },
    {
      "id": "agent-update",
      "command": [
        "fleet",
        "nightly",
        "agent-update",
        "--",
        "fleet",
        "agent-update"
      ],
      "schedule": {
        "every": "1h",
        "at": "00:47"
      },
      "workflow": "nightly-updates"
    },
    {
      "id": "worktree-prune",
      "command": [
        "fleet",
        "prune",
        "--auto"
      ],
      "schedule": {
        "every": "5m"
      },
      "workflow": "worktree-cleanup"
    }
  ],
  "steps": [
    {
      "id": "settings-snapshot",
      "run": [
        "fleet",
        "settings-snapshot"
      ],
      "check": [
        "fleet",
        "settings-snapshot",
        "--check"
      ]
    },
    {
      "id": "shell-session",
      "run": [
        "fleet",
        "shell-session"
      ],
      "check": [
        "fleet",
        "shell-session",
        "--check"
      ],
      "on": [
        "linux"
      ]
    },
    {
      "id": "claude-cli",
      "run": [
        "bash",
        "-c",
        "set -o pipefail; curl -fsSL https://claude.ai/install.sh | bash"
      ],
      "check": [
        "claude",
        "--version"
      ],
      "plans": [
        "claude",
        "both"
      ]
    },
    {
      "id": "codex-cli",
      "run": [
        "fleet",
        "install-codex"
      ],
      "check": [
        "codex",
        "--version"
      ],
      "on": [
        "linux"
      ],
      "plans": [
        "codex",
        "both"
      ]
    },
    {
      "id": "codex-cli-mac",
      "run": [
        "brew",
        "install",
        "--cask",
        "codex"
      ],
      "check": [
        "codex",
        "--version"
      ],
      "on": [
        "darwin"
      ],
      "plans": [
        "codex",
        "both"
      ]
    },
    {
      "id": "cargo-git-cli",
      "run": [
        "fleet",
        "cargo-git-cli"
      ],
      "check": [
        "fleet",
        "cargo-git-cli",
        "--check"
      ],
      "on": [
        "linux"
      ]
    },
    {
      "id": "node-runtime",
      "run": [
        "fleet",
        "install-node"
      ],
      "check": [
        "npx",
        "--version"
      ],
      "on": [
        "linux"
      ]
    }
  ]
}
